{
  "name": "vscode-d365fo-tools-xpp",
  "displayName": "D365FO AOT Browser",
  "description": "Application Explorer / AOT browser for Dynamics 365 Finance and Operations (local metadata).",
  "version": "1.0.0",
  "publisher": "d365collaborative",
  "license": "MIT",
  "homepage": "https://github.com/d365collaborative/vscode-d365fo-tools-xpp#readme",
  "bugs": {
    "url": "https://github.com/d365collaborative/vscode-d365fo-tools-xpp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d365collaborative/vscode-d365fo-tools-xpp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "dynamics365",
    "d365fo",
    "x++",
    "aot",
    "application-explorer"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "d365fo-aot",
          "title": "Application Explorer (Xpp)",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "d365fo-aot": [
        {
          "id": "d365fo-aot-browser",
          "name": "Application Explorer (Xpp)",
          "icon": "resources/activity.svg",
          "contextualTitle": "AOT"
        },
        {
          "id": "d365fo-aot-search-v2",
          "name": "AOT Search",
          "type": "webview",
          "icon": "resources/activity.svg",
          "contextualTitle": "AOT Search"
        }
      ]
    },
    "commands": [
      {
        "command": "d365fo-aot.refresh",
        "title": "Refresh AOT",
        "icon": "$(refresh)"
      },
      {
        "command": "d365fo-aot.toggleView",
        "title": "Toggle Models/Classic View",
        "icon": "$(list-tree)"
      },
      {
        "command": "d365fo-aot.revealModelInExplorer",
        "title": "Reveal Model Folder in Explorer"
      },
      {
        "command": "d365fo-aot.openDescriptor",
        "title": "Open Model Descriptor XML"
      },
      {
        "command": "d365fo-aot.openElement",
        "title": "Open X++ Source"
      },
      {
        "command": "d365fo-aot.openFieldsGrid",
        "title": "Show Table Fields Grid"
      },
      {
        "command": "d365fo-aot.openViewFieldsGrid",
        "title": "Show View Fields Grid"
      },
      {
        "command": "d365fo-aot.openRelationsGrid",
        "title": "Show Table Relations Grid"
      },
      {
        "command": "d365fo-aot.openIndexesGrid",
        "title": "Show Table Indexes Grid"
      },
      {
        "command": "d365fo-aot.openMetadataGrid",
        "title": "Show Metadata"
      },
      {
        "command": "d365fo-aot.resolveFieldTypes",
        "title": "Resolve Field Types"
      },
      {
        "command": "d365fo-aot.openProperties",
        "title": "Show Properties"
      },
      {
        "command": "d365fo-aot.openElementXml",
        "title": "Open Raw Element XML"
      },
      {
        "command": "d365fo-aot.openSearch",
        "title": "Open AOT Search",
        "icon": "$(search)"
      }
    ],
