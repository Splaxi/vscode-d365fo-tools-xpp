    "menus": {
      "view/title": [
        {
          "command": "d365fo-aot.refresh",
          "when": "view == d365fo-aot-browser",
          "group": "navigation@1"
        },
        {
          "command": "d365fo-aot.openSearch",
          "when": "view == d365fo-aot-browser",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "d365fo-aot.toggleView",
          "when": "view == d365fo-aot-browser && viewItem == d365fo-version",
          "group": "1_actions@3"
        },
        {
          "command": "d365fo-aot.refresh",
          "when": "view == d365fo-aot-browser",
          "group": "1_actions@1"
        },
        {
          "command": "d365fo-aot.openDescriptor",
          "when": "view == d365fo-aot-browser && viewItem == d365fo-model",
          "group": "inline@1"
        },
        {
          "command": "d365fo-aot.revealModelInExplorer",
          "when": "view == d365fo-aot-browser && (viewItem == d365fo-model || viewItem == d365fo-element || viewItem == d365fo-enumvalue || viewItem == d365fo-tablesection || viewItem == d365fo-member)",
          "group": "2_model@1"
        },
        {
          "command": "d365fo-aot.openElementXml",
          "when": "view == d365fo-aot-browser && viewItem == d365fo-element",
          "group": "2_element@2"
        },
        {
          "command": "d365fo-aot.resolveFieldTypes",
          "when": "view == d365fo-aot-browser && (viewItem == d365fo-element || viewItem == d365fo-tablesection || viewItem == d365fo-member || viewItem == d365fo-xmlnode)",
          "group": "2_element@4"
        },
        {
          "command": "d365fo-aot.openProperties",
          "when": "view == d365fo-aot-browser && viewItem == d365fo-element",
          "group": "2_element@3"
        },
        {
          "command": "d365fo-aot.openElement",
          "when": "view == d365fo-aot-browser && viewItem == d365fo-element",
          "group": "2_element@1"
        }
      ]
    },
    "grammars": [
      {
        "language": "xpp",
        "scopeName": "source.xpp",
        "path": "./syntaxes/xpp.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "xpp",
        "aliases": [
          "X++",
          "xpp"
        ],
        "extensions": [
          ".xpp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "D365FO AOT Browser",
      "properties": {
        "d365fo.aot.ude.rootPath": {
          "type": "string",
          "default": "%LocalAppData%\\Microsoft\\Dynamics365",
          "description": "Versions root shown as MS-UDE. Each direct sub-folder is treated as a version; models are folders containing a Descriptor/*.xml file (searched under AOSService/PackagesLocalDirectory when present). Supports %ENV% and ~ expansion.",
          "order": 1
        },
        "d365fo.aot.rootPath": {
          "type": "string",
          "default": "K:\\AosService\\PackagesLocalDirectory",
          "description": "Single packages root shown as MS-Packages (a folder with model folders directly inside). Missing folders simply expand to nothing. Supports %ENV% and ~ expansion.",
          "order": 2
        },
        "d365fo.aot.custom.rootPath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional metadata roots shown under Custom. Each entry is treated as one version (either a version folder or a packages folder). Missing folders simply expand to nothing. Supports %ENV% and ~ expansion.",
          "order": 3
        },
        "d365fo.aot.modelSearchDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "description": "How many directory levels below each version (or its PackagesLocalDirectory) are scanned for model Descriptor folders. Keep low for speed.",
          "order": 4
        },
        "d365fo.aot.showDescriptorPath": {
          "type": "boolean",
          "default": false,
          "description": "Show the full descriptor path as the tree item description.",
          "order": 5
        },
        "d365fo.aot.eagerLoad": {
          "type": "boolean",
          "default": true,
          "description": "Eagerly prefetch the next level (+1) in the background while navigating the Classic view: expanding a category preloads the first elements of every type in parallel.",
          "order": 6
        },
        "d365fo.aot.prefetchCount": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "maximum": 10000,
          "description": "How many elements per type the eager prefetch loads. Types at or below this size complete outright; larger types render the prefetched head instantly while the rest loads in the background.",
          "order": 7
        },
        "d365fo.aot.defaultViewMode": {
          "type": "string",
          "enum": [
            "models",
            "classic"
          ],
          "default": "models",
          "description": "Which view each version opens in. Can still be flipped per version with the toggle left of Refresh.",
          "order": 8
        },
        "d365fo.aot.resolve.language": {
          "type": "string",
          "default": "en-US",
          "description": "Language used by Resolve to translate label ids (@SYS…, @QMS:…) into text. Falls back to the base language (en-US → en) when a model has no folder for it, and leaves the id untouched when neither exists.",
          "order": 9
        },
        "d365fo.aot.autoResolve": {
          "type": "boolean",
          "default": false,
          "description": "Resolve the Fields grid as soon as you pick a field, instead of pressing Resolve. When on, the Resolve button is disabled because the work already happens on selection.",
          "order": 10
        },
        "d365fo.aot.ude.cache.memory": {
          "type": "boolean",
          "default": true,
          "description": "Keep MS-UDE element lists in memory. Off caps RAM (reads go to the disk index); the disk index still refreshes in the background.",
          "order": 9
        },
        "d365fo.aot.ude.cache.ttlMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "MS-UDE cache freshness in minutes. 0 disables background refresh (manual Refresh only). A background rebuild starts 5 minutes before expiry and swaps atomically when ready.",
          "order": 10
        },
        "d365fo.aot.packages.cache.memory": {
          "type": "boolean",
          "default": true,
          "description": "Keep MS-Packages element lists in memory. Off caps RAM (reads go to the disk index); the disk index still refreshes in the background.",
          "order": 11
        },
        "d365fo.aot.packages.cache.ttlMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "MS-Packages cache freshness in minutes. 0 disables background refresh (manual Refresh only). A background rebuild starts 5 minutes before expiry and swaps atomically when ready.",
          "order": 12
        },
        "d365fo.aot.custom.cache.memory": {
          "type": "boolean",
          "default": true,
          "description": "Keep Custom element lists in memory. Off caps RAM (reads go to the disk index); the disk index still refreshes in the background.",
          "order": 13
        },
        "d365fo.aot.custom.cache.ttlMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Custom cache freshness in minutes. 0 disables background refresh (manual Refresh only). A background rebuild starts 5 minutes before expiry and swaps atomically when ready.",
          "order": 14
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "icons": "node ./scripts/build-icons.mjs",
    "watch": "tsc -watch -p ./",
    "lint": "echo \"no linter configured\"",
    "package": "vsce package",
    "package:clean": "rimraf *.vsix out",
    "release": "node ./scripts/release.mjs --bump patch",
    "release:minor": "node ./scripts/release.mjs --bump minor",
    "release:major": "node ./scripts/release.mjs --bump major",
    "release:if-changed": "node ./scripts/release.mjs --bump patch --if-changed"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
